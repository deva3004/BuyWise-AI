# Copy to .env and fill in. Used both for local (uv run) development and
# by docker-compose (which reads .env automatically for the POSTGRES_*
# and GROQ_API_KEY substitutions in docker-compose.yml).

# Local dev (uv run uvicorn / uv run streamlit): full connection string
# pointing at whatever Postgres you're running yourself.
DATABASE_URL=postgresql://buywise:buywise@localhost:5432/buywise

# docker-compose builds DATABASE_URL itself from these three (pointing at
# the `postgres` service, not localhost) — only used for the postgres
# container's own credentials.
POSTGRES_USER=buywise
POSTGRES_PASSWORD=buywise
POSTGRES_DB=buywise

GROQ_API_KEY=your_groq_api_key_here

# Signs and verifies JWTs (app/auth.py). Symmetric key (HS256) - every
# FastAPI instance needs the identical value, which is what lets JWT auth
# work across multiple instances behind a future load balancer with no
# shared session store. Generate a real one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET_KEY=change-me-to-a-real-random-secret
JWT_EXPIRE_MINUTES=1440
